def binary_labels(num_qubits):
    """Generates a list of binary labels for a given number of qubits."""
    return [bin(x)[2:].zfill(num_qubits) for x in range(2**num_qubits)]

class BB84:
    def __init__(self):
        #qubits and simulator defined
        self.qubit = cirq.NamedQubit("q0")
        self.ancilla = cirq.NamedQubit("a0")
        self.simulator = cirq.Simulator()

        #Individual Keys used by Alice, Bob, and Eve
        self.alice_key = []
        self.bob_key = []
        self.eve_key = []

        #Circuits created by Alice, Bob, and Eve
        self.alice_circuit = cirq.Circuit()
        self.bob_circuit = cirq.Circuit()
        self.eve_circuit = cirq.Circuit()
        self.final_circuit = cirq.Circuit()

        #final bits
        self.alice_bit = None
        self.bob_bit = None
        self.eve_bit = None

        #base chosen
        self.alice_basis = None
        self.bob_basis = None
        self.bases_C = None
        self.bases_H = None
        #cumulative errors
        self.errors = 0
        self.no_errors = 0
        self.c_errors = 0
        self.c_no_errors = 0
        self.h_no_errors = 0
        self.h_errors = 0

        #Eve's information gain
        self.eve_information_gain = 0

    def alice_prepare(self):
      bit = random.randint(0,1)
      if bit == 0:
        self.alice_circuit.append(cirq.I(self.qubit))
        self.alice_bit = 0
      elif bit == 1:
        self.alice_circuit.append(cirq.X(self.qubit))
        self.alice_bit = 1
      basis = random.randint(0,1)
      if basis == 0:
        self.alice_circuit.append(cirq.I(self.qubit))
        self.alice_basis = "C"
      elif basis == 1:
        self.alice_circuit.append(cirq.H(self.qubit))
        self.alice_basis = "H"
      print('alice bit: ', self.alice_bit)

    def eve_intercept(self):
      self.eve_circuit.append(cirq.CNOT(self.qubit, self.ancilla))
      self.eve_circuit.append(cirq.MeasurementGate(1, key='m')(self.ancilla))

    def bob_measure(self):
      basis = random.randint(0,1)
      if basis == 0:
        self.bob_circuit.append(cirq.I(self.qubit))
        self.bob_basis = "C" 
      elif basis == 1:
        self.bob_circuit.append(cirq.H(self.qubit))
        self.bob_basis = "H" 
      self.bob_circuit.append(cirq.MeasurementGate(1,key='f')(self.qubit))

    def build_final_circuit(self):
      self.final_circuit = self.alice_circuit + self.eve_circuit + self.bob_circuit
      print(self.final_circuit)
    
    def sifting(self):
      if self.alice_basis == self.bob_basis:
        if self.eve_bit == self.alice_bit:
          self.eve_information_gain += 1
        self.bob_key.append(self.bob_bit)
        self.alice_key.append(self.alice_bit)
        self.eve_key.append(self.eve_bit)
        if self.bob_bit == self.alice_bit:
          self.no_errors += 1
          if self.alice_basis == "C":
            self.c_no_errors += 1
          elif self.alice_basis == "H":
            self.h_no_errors += 1
        elif self.bob_bit != self.alice_bit:
          self.errors += 1  
          if self.alice_basis == "C":
            self.c_errors += 1
          elif self.alice_basis == "H":
            self.h_errors += 1
      else:
        pass

  
    def run_protocol(self):
      self.alice_circuit = cirq.Circuit()
      self.bob_circuit = cirq.Circuit()
      self.eve_circuit = cirq.Circuit()
      self.final_circuit = cirq.Circuit()
      self.alice_prepare()
      self.eve_intercept()
      self.bob_measure()
      self.build_final_circuit()
      result = self.simulator.run(self.final_circuit, repetitions=1)
      self.bob_bit = result.measurements['f'][0][0]
      self.eve_bit = result.measurements['m'][0][0]
      self.sifting()
      print('bob bit: ', self.bob_bit)
      
Simulation = BB84()
iterations = 2000
for i in range(iterations):
  Simulation.run_protocol()

